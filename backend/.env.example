NODE_ENV=development
PORT=3000

# false = use MONGODB_URI (Atlas or local). true = ephemeral in-memory replica set (tests/dev without Atlas).
MONGODB_MEMORY=false
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gbl_adminOffice?retryWrites=true&w=majority

JWT_ACCESS_SECRET=replace-with-a-32-char-minimum-access-secret
JWT_REFRESH_SECRET=replace-with-a-32-char-minimum-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

BOOTSTRAP_ADMIN_EMAIL=admin@gblenterprise.com
BOOTSTRAP_ADMIN_PASSWORD=Admin123!
