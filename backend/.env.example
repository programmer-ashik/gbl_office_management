NODE_ENV=production
PORT=3000

# false = use MONGODB_URI. true = in-memory (tests only).
MONGODB_MEMORY=false
MONGODB_URI=mongodb://localhost:27017/gbl_office

JWT_ACCESS_SECRET=replace-with-a-32-char-minimum-access-secret
JWT_REFRESH_SECRET=replace-with-a-32-char-minimum-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated frontend origins
CORS_ORIGIN=https://your-domain.com

# Created only when the users collection is empty (first boot).
BOOTSTRAP_ADMIN_EMAIL=admin@yourcompany.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password

# Demo users / sample vouchers. Leave false for production.
SEED_DEMO=false
