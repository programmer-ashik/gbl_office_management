NODE_ENV=production
PORT=3000

# MongoDB (MONGO_URI is accepted as an alias for MONGODB_URI)
MONGODB_URI=mongodb://localhost:27017/gbl_office
MONGO_URI=mongodb://localhost:27017/gbl_office

# Must be at least 32 characters each
JWT_ACCESS_SECRET=replace-with-a-32-char-minimum-access-secret
JWT_REFRESH_SECRET=replace-with-a-32-char-minimum-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGIN=https:gbloffice.gblent.com

BOOTSTRAP_ADMIN_EMAIL=admin@gbloffice.com
BOOTSTRAP_ADMIN_PASSWORD=global@admin2026
